from __future__ import annotations

import os
import re
from pathlib import PurePosixPath

from .models import (
    Domain,
    GeneratedFile,
    GenerationResponse,
    RequirementInterpretation,
    ScenarioRequest,
    StoredGeneration,
    TestCase,
)


def _slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_")[:48] or "scenario"


def _infer_sut(request: ScenarioRequest) -> str:
    if request.domain == Domain.HEALTHCARE:
        return "Healthcare PMS / RCM workflow and its integrated services"
    if request.domain == Domain.KUBERNETES:
        return "Cloud-native service deployed on Kubernetes"
    return request.title


def analyze(request: ScenarioRequest) -> tuple[RequirementInterpretation, list[TestCase]]:
    concurrency = any(word in request.description.lower() for word in ("concurrent", "simultaneous", "race"))
    facts = [request.description]
    assumptions = [
        "The target environment and credentials are supplied through environment variables.",
        "Generated checks must be adapted to the real API contract before execution.",
    ]
    criteria = [
        "The primary business outcome is asserted explicitly.",
        "Unexpected status codes and malformed responses produce actionable failures.",
        "No credentials or production connection strings are embedded in source files.",
    ]
    risks = ["The scenario does not include a verified API schema or endpoint catalog."]
    questions = ["What is the canonical endpoint, authentication flow, and response schema?"]
    cases = [
        TestCase(id="TF-001", title="Validate the expected happy path", category="Positive", priority="High", preconditions=["Test environment is available", "Synthetic test data is prepared"], steps=["Arrange the documented request", "Send the request with a bounded timeout", "Validate the response contract and business outcome"], expected="The request succeeds and all documented invariants hold."),
        TestCase(id="TF-002", title="Reject invalid input safely", category="Negative", priority="High", preconditions=["Test environment is available"], steps=["Send a malformed or incomplete request", "Inspect status, error contract, and side effects"], expected="The service returns the documented client error and does not create invalid state."),
        TestCase(id="TF-003", title="Verify timeout and retry behavior", category="Resilience", priority="Medium", preconditions=["A controllable dependency or test double is available"], steps=["Introduce a bounded dependency delay", "Observe timeout, retry count, and final error handling"], expected="Retries are bounded and failures are observable without duplicate side effects."),
    ]
    if concurrency:
        cases.append(TestCase(id="TF-004", title="Protect the business invariant under concurrent requests", category="Concurrency", priority="Critical", preconditions=["Two or more isolated clients can issue the same logical request", "Database verification access is read-only"], steps=["Issue equivalent requests concurrently", "Collect all responses", "Verify the resulting records and idempotency invariant"], expected="At most one logical record is created and all responses follow the documented contract."))
    interpretation = RequirementInterpretation(objective=f"Validate: {request.title}", system_under_test=_infer_sut(request), facts=facts, assumptions=assumptions, acceptance_criteria=criteria, risks=risks, open_questions=questions)
    return interpretation, cases



def build_files(
    request: ScenarioRequest,
    interpretation: RequirementInterpretation,
    cases: list[TestCase],
) -> list[GeneratedFile]:
    slug = _slug(request.title)

    test_functions = []

    for case in cases:
        test_name = _slug(case.title)

        if case.category == "Concurrency":
            test_body = '''
    import os
    import pytest
    from concurrent.futures import ThreadPoolExecutor

    endpoint = os.getenv("TESTFORGE_REGISTER_ENDPOINT")
    if not endpoint:
        pytest.skip("Configure TESTFORGE_REGISTER_ENDPOINT from the API contract")

    pytest.skip(
        "Configure the documented request payload and read-back endpoint "
        "before executing concurrency assertions"
    )
'''
        elif case.category == "Negative":
            test_body = '''
    import pytest

    pytest.skip(
        "Configure the documented invalid payload and expected response "
        "before executing this test"
    )
'''
        elif case.category == "Resilience":
            test_body = '''
    import pytest

    pytest.skip(
        "Configure documented timeout and retry behavior before execution"
    )
'''
        else:
            test_body = '''
    import pytest

    pytest.skip(
        "Configure the documented endpoint, payload, and response contract "
        "before executing this test"
    )
'''

        test_functions.append(
            f"def test_{test_name}(api_client):\\n"
            f'    """{case.expected}"""\\n'
            f"{test_body}\\n"
        )

    test_names = "\\n".join(test_functions)

    readme = f"""# TestForge generated project

## Scenario
{request.description}

## Status
Generated project with static validation only. This project is not
production-approved. Configure the real API contract and test environment
before executing tests.

## Setup
```powershell
python -m venv .venv
.\\.venv\\Scripts\\Activate.ps1
pip install -r requirements.txt
```

Set TESTFORGE_BASE_URL and any required authentication environment
variables before running pytest.

## Run
```powershell
python -m pytest -q
```

Tests that require missing API contract details are intentionally skipped.
"""

    files = [
        GeneratedFile(path="README.md", content=readme),
        GeneratedFile(
            path="requirements.txt",
            content="pytest>=8.3,<9\\nrequests>=2.32,<3\\npython-dotenv>=1.0,<2\\n",
        ),
        GeneratedFile(
            path=".env.example",
            content=(
                "TESTFORGE_BASE_URL=http://localhost:8000\\n"
                "TESTFORGE_TOKEN=\\n"
                "TESTFORGE_REGISTER_ENDPOINT=\\n"
            ),
        ),
        GeneratedFile(
            path="config/settings.py",
            content=(
                "from __future__ import annotations\n"
                "import os\n\n"
                'BASE_URL = os.getenv("TESTFORGE_BASE_URL", "http://localhost:8000").rstrip("/")\\n'
                'TOKEN = os.getenv("TESTFORGE_TOKEN")\\n'
                'TIMEOUT_SECONDS = float(os.getenv("TESTFORGE_TIMEOUT_SECONDS", "10"))\\n'
            ),
        ),
        GeneratedFile(
            path="clients/api_client.py",
            content=(
                "from __future__ import annotations\\n"
                "import requests\\n"
                "from config.settings import BASE_URL, TIMEOUT_SECONDS, TOKEN\\n\\n"
                "class ApiClient:\\n"
                "    def __init__(self, base_url: str = BASE_URL) -> None:\\n"
                "        self.session = requests.Session()\\n"
                "        self.base_url = base_url.rstrip('/')\\n"
                "        if TOKEN:\\n"
                "            self.session.headers.update({'Authorization': f'Bearer {TOKEN}'})\\n\\n"
                "    def get(self, path: str, **kwargs) -> requests.Response:\\n"
                "        return self.session.get(f'{self.base_url}{path}', timeout=TIMEOUT_SECONDS, **kwargs)\\n\\n"
                "    def post(self, path: str, json: dict, **kwargs) -> requests.Response:\\n"
                "        return self.session.post(f'{self.base_url}{path}', json=json, timeout=TIMEOUT_SECONDS, **kwargs)\\n"
            ),
        ),
        GeneratedFile(
            path="tests/conftest.py",
            content=(
                "import pytest\\n"
                "from clients.api_client import ApiClient\\n\\n"
                "@pytest.fixture\\n"
                "def api_client() -> ApiClient:\\n"
                "    return ApiClient()\\n"
            ),
        ),
        GeneratedFile(
            path=f"tests/api/test_{slug}.py",
            content=(
                "import pytest\\n"
                "from concurrent.futures import ThreadPoolExecutor\\n\\n"
                f"{test_names}\\n"
            ),
        ),
        GeneratedFile(
            path="pyproject.toml",
            content=(
                "[tool.pytest.ini_options]\\n"
                'addopts = "-ra"\\n'
                'testpaths = ["tests"]\\n\\n'
                "[tool.ruff]\\n"
                "line-length = 100\\n"
            ),
        ),
        GeneratedFile(
            path=".gitignore",
            content=".env\\n.venv/\\n.pytest_cache/\\n__pycache__/\\nreports/*\\n!reports/.gitkeep\\n",
        ),
        GeneratedFile(path="reports/.gitkeep", content=""),
    ]

    return files

def generate(request: ScenarioRequest) -> StoredGeneration:
    interpretation, cases = analyze(request)

    return StoredGeneration(
        request=request,
        interpretation=interpretation,
        test_cases=cases,
        files=build_files(request, interpretation, cases),
        metadata={
            "provider": os.getenv("AI_PROVIDER", "local"),
            "prompt_version": "local-v1",
        },
    )

